{
  "mcpServers": {
    "algobharat-conway-state-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Algorand",
        "PROJECT_TICKER": "ABCONWAY"
      },
      "tools": [
        {
          "name": "verify_abconway_invariants",
          "description": "Verifies deterministic invariants for AlgoBharat Conway State AI on Algorand."
        },
        {
          "name": "execute_abconway_action",
          "description": "Executes authenticated Infrastructure state transition."
        }
      ]
    }
  }
}